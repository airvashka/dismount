# Zkopíruj jako .env.local a vyplň.

# Náhodný secret pro session (vygeneruj: npx auth secret, nebo libovolný random string)
AUTH_SECRET=

# Discord OAuth aplikace — discord.com/developers -> Applications -> OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot token téže aplikace (záložka Bot) — čte role členů, posílá posty do #call-to-arms
DISCORD_BOT_TOKEN=

# ID Discord serveru guildy (pravý klik na server -> Copy Server ID, zapnout Developer Mode)
DISCORD_GUILD_ID=

# Volitelné: Discord user ID (čárkami oddělená), která mají na webu VŽDY max práva
# bez ohledu na Discord roli (správci webu). Platí hned, bez re-loginu.
WEB_ADMINS=

# Volitelné vlastní kanály pro typy akcí "Ava Raid" / "Random Content" —
# bez nich se použije CTA_CHANNEL_ID v lib/discord-notify.ts.
DISCORD_AVA_CHANNEL_ID=
DISCORD_RANDOM_CHANNEL_ID=

# Tajný token pro /api/cron/reminders — bez něj je endpoint natvrdo 401.
# Volá se periodicky (~5 min) přes system cron na hostu: curl
# "https://dismount.team/api/cron/reminders?token=<CRON_SECRET>"
CRON_SECRET=
