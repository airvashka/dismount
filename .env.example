# Copy to .env.local and fill in.

# Random session secret (e.g. openssl rand -hex 32)
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Local sandbox (NODE_ENV=development only)
# ---------------------------------------------------------------------------
# Master switch: fake login, dev UI tools, Discord never targets production channels.
DEV_ENVIRONMENT=true

# Fake session role (default admin if unset). Header "test" badge + role dropdown.
# Values: admin | caller | member | recruit | novice | dismount | guest
# Aliases: leadership → admin,  true / 1 / yes → admin
DEV_FAKE_ROLE=admin
# DEV_FAKE_NAME=Local admin
# DEV_FAKE_DISCORD_ID=dev-000

# Optional: post event announces to a *test* Discord channel (needs DISCORD_BOT_TOKEN).
# If unset while DEV_ENVIRONMENT=true, Discord posts are no-op (no prod fallback).
# DEV_DISCORD_CTA_CHANNEL_ID=
# DEV_DISCORD_AVA_CHANNEL_ID=
# DEV_DISCORD_RANDOM_CHANNEL_ID=

# Discord OAuth — not required when DEV_ENVIRONMENT is on.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot token — member roles + channel posts. Without it, Discord is no-op.
DISCORD_BOT_TOKEN=

# Guild server ID (Developer Mode → Copy Server ID)
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs that always get admin on the web.
WEB_ADMINS=

# Optional production channels for Ava Raid / Random Content (prod only).
DISCORD_AVA_CHANNEL_ID=
DISCORD_RANDOM_CHANNEL_ID=

# Cron secret for /api/cron/reminders — 401 without it.
CRON_SECRET=
